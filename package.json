{
  "name": "sapremo-warehouse",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-First Warehouse Management System (WMS) & High-Fidelity STOMP/REST Mock Gateway Monorepo",
  "author": "Adilet Batyrov <adiletbatyrov2009@gmail.com>",
  "license": "MIT",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:client": "npm run dev --workspace=warehouse-manager",
    "dev:server": "npm run dev --workspace=@sapremo/mock-server",
    "build": "turbo run build",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.4.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
