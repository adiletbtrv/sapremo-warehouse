# Sapremo Warehouse Client — Environment Configuration

# Unified Gateway API URL (proxied in dev or direct to Mock Gateway on port 3001)
VITE_API_URL=/api

# Unified WebSocket / STOMP Endpoint URL
VITE_WS_URL=/api/warehouse/ws

# Service-Specific API Overrides (optional, derived from VITE_API_URL by default)
VITE_WAREHOUSE_API_URL=/api/warehouse
VITE_FACTORY_API_URL=/api/factory
VITE_DRIVERS_API_URL=/api/drivers

# Request Timeout (ms)
VITE_API_TIMEOUT=15000

# Feature Flags
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_SYNC_DEBUG=true

# Application Metadata
VITE_APP_VERSION=1.0.0
